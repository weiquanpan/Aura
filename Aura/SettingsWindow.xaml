<Window x:Class="Aura.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Aura"
        mc:Ignorable="d"
        Title="Aura Settings" Height="400" Width="500"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <StackPanel>
            <Label Content="Gemini API Key:"/>
            <TextBox x:Name="ApiKeyTextBox" Margin="0,0,0,10"/>

            <Label Content="Custom Prompt (use {input} as placeholder):"/>
            <TextBox x:Name="PromptTextBox" Margin="0,0,0,10" Height="80" TextWrapping="Wrap" AcceptsReturn="True"/>

            <CheckBox x:Name="ProxyCheckBox" Content="Enable Network Proxy" Margin="0,10,0,5"/>
            <Label Content="Proxy Server Address (e.g., http://127.0.0.1:7890):"/>
            <TextBox x:Name="ProxyTextBox" Margin="0,0,0,20"/>

            <Button x:Name="SaveButton" Content="Save" Width="100" HorizontalAlignment="Right" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
