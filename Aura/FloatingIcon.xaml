<Window x:Class="Aura.FloatingIcon"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aura" Height="40" Width="40"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual">
    <Grid>
        <Button x:Name="IconButton" Click="IconButton_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
            <Grid>
                <Ellipse Fill="DodgerBlue" Opacity="0.8"/>
                <TextBlock Text="A" Foreground="White" FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Button>
    </Grid>
</Window>
